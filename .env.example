# 默认 SQLite，数据库为项目目录下的 data/research.db。
# 仅使用外部数据库时填写 DATABASE_URL，或配置下方 PostgreSQL 参数。
DATABASE_URL=
POSTGRES_HOST=
POSTGRES_USER=researcher
POSTGRES_DB=stock_research
POSTGRES_PASSWORD=
RESEARCH_DISPLAY_TIMEZONE=Asia/Shanghai

# 大盘简报的可选 AI 解读。密钥留空时使用程序生成的技术研判。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 飞书群自定义机器人。仅在机器人启用签名校验时填写签名密钥。
FEISHU_WEBHOOK_URL=
FEISHU_SIGNING_SECRET=

# Alpaca 盘中监控。填齐两项凭据并把 INTRADAY_ENABLED 改成 true 来启用。
INTRADAY_ENABLED=false
INTRADAY_FEISHU_ENABLED=true
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
