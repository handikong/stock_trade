# 轻量部署默认使用 data/research.db；使用独立 PostgreSQL 时再配置。
DATABASE_URL=
POSTGRES_HOST=
POSTGRES_USER=researcher
POSTGRES_DB=stock_research
POSTGRES_PASSWORD=

# 可选；大盘简报使用 DeepSeek 解读，密钥只填在服务器 .env。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# 可选；使用真实飞书提醒时仅在服务器 .env 中填写。
FEISHU_WEBHOOK_URL=
FEISHU_SIGNING_SECRET=

# 美股盘中监控，启用后由 deploy.sh 构建 Go 行情程序。
INTRADAY_ENABLED=false
INTRADAY_FEISHU_ENABLED=true
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
